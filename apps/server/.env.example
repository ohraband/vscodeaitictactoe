DATABASE_URL=postgresql://ttt:ttt@localhost:5432/ttt
SESSION_SECRET=replace-me-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SESSION_TTL_DAYS=30
# Set to 0 to disable the multiplayer turn timer.
TURN_SECONDS=60
# Socket.IO heartbeat used to detect dropped connections and publish presence.
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
# Set to false only for controlled test runs.
RATE_LIMIT_ENABLED=true
# Emit CSP upgrade-insecure-requests. Enable only when the app is served over HTTPS
# (e.g. behind a TLS-terminating reverse proxy). Keep false for plain-HTTP local Docker.
CSP_UPGRADE_INSECURE_REQUESTS=false
# Mark the session cookie Secure. Enable only when the app is served over HTTPS; a Secure
# cookie is not sent over plain HTTP, which also breaks the Socket.IO handshake.
SESSION_COOKIE_SECURE=false
# Optional replica label for Prometheus aggregation across pods.
# METRICS_REPLICA_ID=ttt-0
# Optional: enables the Socket.IO Redis adapter, shared rate limits, and Redis readiness.
# REDIS_URL=redis://localhost:6379
# Optional: enables best-effort Kafka analytics publishing. Leave unset to disable it.
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=ttt-server
# KAFKA_ANALYTICS_TOPIC=ttt.game.completed
# KAFKA_ANALYTICS_GROUP_ID=ttt-analytics
# Optional: enable the Kafka cursor stream. Requires KAFKA_BROKERS and the cursor consumer.
# CURSOR_ENABLED=false
# CURSOR_PORT=3001
# KAFKA_CURSOR_TOPIC=ttt.cursor.moved
# KAFKA_CURSOR_GROUP_ID=ttt-cursor
