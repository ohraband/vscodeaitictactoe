# Copy this file to .env in the deployment directory (or keep it outside the
# repository and pass --env-file), then restrict it with chmod 600 and replace
# every value.

# Applied when Postgres initializes an empty data volume.
# Use a URL-safe value so it can be embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16

# Must be at least 32 characters.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Required by the production Compose overlay.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Public hostname served by the bundled Caddy container.
# Point an A record for this name at the VPS IPv4 address.
TTT_DOMAIN=game.example.com

# The app and cursor consumer stay on the Compose network. Caddy reaches them
# by service name and is the only public listener.

# The production deployment is served over HTTPS by Caddy.
CSP_UPGRADE_INSECURE_REQUESTS=true
SESSION_COOKIE_SECURE=true

# Analytics profile. Comment this out if you do not start the analytics profile,
# otherwise the app will log best-effort publish warnings.
KAFKA_BROKERS=redpanda:9092
# KAFKA_CLIENT_ID=ttt-server
# KAFKA_ANALYTICS_TOPIC=ttt.game.completed
# KAFKA_ANALYTICS_GROUP_ID=ttt-analytics

# Cursor profile. compose.cursor.yaml sets CURSOR_ENABLED=true; leave this false
# when you do not include that overlay and the cursor profile.
CURSOR_ENABLED=false
# CURSOR_PORT=3001
# KAFKA_CURSOR_TOPIC=ttt.cursor.moved
# KAFKA_CURSOR_GROUP_ID=ttt-cursor
